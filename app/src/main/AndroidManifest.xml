<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimum and target SDKs (adjust values if your project uses different targets) -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Launcher activity (your workouts / routines entry point) -->
        <activity
            android:name=".WorkoutRoutineActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Routine details screen -->
        <activity
            android:name=".RoutineDetailsActivity"
            android:exported="false" />

        <!-- Add any other activities here and set android:exported accordingly -->
    </application>

</manifest>