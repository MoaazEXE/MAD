<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.bytelift">

    <!-- Minimum/target SDK (adjust if your project uses different values) -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Launcher / entry activity -->
        <activity
            android:name=".WorkoutRoutineActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Existing details activity -->
        <activity
            android:name=".RoutineDetailsActivity"
            android:exported="false" />

        <!-- NEW: Presets list (tabs) -->
        <activity
            android:name=".PresetsActivity"
            android:exported="false" />

        <!-- NEW: Preset details (shows days + exercises, Use Routine button) -->
        <activity
            android:name=".PresetDetailsActivity"
            android:exported="false" />

        <!-- Add any other activities here -->
    </application>

</manifest>