<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Launcher -->
        <activity
            android:name="com.example.bytelift.WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Core app -->
        <activity
            android:name="com.example.bytelift.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />


        <!-- WORKOUT SYSTEM (Arkana workout page) -->
        <activity
            android:name="com.example.bytelift.ui.workout.activities.WorkoutActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.ui.workout.activities.SelectDaysActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.ui.workout.activities.AddExercisesActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.ui.workout.activities.ReviewRoutineActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.ui.workout.activities.PresetsActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.ui.workout.activities.PresetDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.ui.workout.activities.RoutineDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name="com.example.bytelift.ui.workout.activities.ExerciseLibraryActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

        <activity
            android:name=".ui.settings_page.EditAccountActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings_page.ReminderScheduleActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication.NoActionBar" />

    </application>

</manifest>
