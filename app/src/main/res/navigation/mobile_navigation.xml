<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.bytelift.ui.profile.ProfileFragment"
        android:label="@string/menu_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.bytelift.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_leaderboard"
        android:name="com.example.bytelift.ui.leaderboard.LeaderboardFragment"
        android:label="@string/menu_leaderboard"
        tools:layout="@layout/fragment_leaderboard" />
    <activity
        android:id="@+id/nav_workout"
        android:name="com.example.bytelift.ui.workout.activities.WorkoutActivity"
        android:label="@string/menu_workout" />

    <fragment
        android:id="@+id/nav_diet"
        android:name="com.example.bytelift.ui.diet.DietFragment"
        android:label="@string/menu_diet"
        tools:layout="@layout/fragment_diet">

        <!-- ⭐ Add action to Recipes screen -->
        <action
            android:id="@+id/action_nav_diet_to_nav_recipes"
            app:destination="@id/nav_recipes" />
    </fragment>

    <fragment
        android:id="@+id/nav_recipes"
        android:name="com.example.bytelift.ui.diet.RecipesFragment"
        android:label="Recipes"
        tools:layout="@layout/fragment_recipes" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.bytelift.ui.settings_page.SettingsFragment"
        android:label="@string/menu_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
