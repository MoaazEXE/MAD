<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_preset_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Push Pull Legs"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_days_per_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6 days/week"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_preset_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classic PPL split for muscle building"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:id="@+id/layout_preset_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <Button
            android:id="@+id/btn_copy_workout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/copy_workout"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:background="@drawable/green_button"/>

    </LinearLayout>

</ScrollView>