<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_background"
    android:gravity="center">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 WORKOUT LOGGED!  🔥"
        android:textColor="@color/gym_green"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <!-- Routine Name -->
    <TextView
        android:id="@+id/tv_dialog_routine_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Push Pull Legs"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/divider_dark"/>

    <!-- Week Progress Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📊 This Week"
        android:textColor="@color/text_muted"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tv_dialog_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2 of 3 workouts"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="66"
        android:progressTint="@color/gym_green"
        android:progressBackgroundTint="@color/dark_gray"/>

    <!-- Streak Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <!-- Current Streak -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Current"
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_dialog_current_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="3 weeks"
                android:textColor="@color/gym_green"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Longest Streak -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Longest"
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_dialog_longest_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="5 weeks"
                android:textColor="@color/warning"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Motivation Message -->
    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="⏰ 1 more workout to maintain your streak!"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"/>

    <!-- Button -->
    <Button
        android:id="@+id/btn_dialog_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="AWESOME!"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@drawable/button_green"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"/>

</LinearLayout>